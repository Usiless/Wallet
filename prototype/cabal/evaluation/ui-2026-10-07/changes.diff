+.row .money{flex-shrink:0}.row .grow{overflow-wrap:anywhere}
+.data-line{align-items:baseline;gap:16px}.data-line>span{min-width:0;overflow-wrap:anywhere}
+.data-line>span:first-child{flex:1}.data-line>span:last-child{flex:1;text-align:right}
+.payment-name,.card h3,.header-title{overflow-wrap:anywhere;min-width:0}
+.payment-name{line-height:1.3}.hero .amount{overflow-wrap:anywhere}
