+.financial-summary button{min-height:64px}.financial-summary strong{margin:6px 0}
+.home-content{padding-bottom:20px}
+.home-fab{position:relative;right:auto;bottom:auto;align-self:flex-end;flex-shrink:0;height:56px;margin:8px 20px 12px}
+.home-fab-options{z-index:5;padding:8px;border:1px solid var(--line);border-radius:16px;background:var(--paper);min-width:190px;max-width:calc(100vw - 32px)}
+.home-fab-options .button{box-shadow:none;border:0;width:100%;min-width:0;min-height:48px;font-size:14px}
+.home-fab-options .button:hover{background:#eaf0e6}
+.home-fab summary:focus-visible{outline-offset:4px}
+.error-box{font-size:14px;color:#89382d;line-height:1.5}
+.form-error:focus-visible{outline:2px solid #89382d;outline-offset:3px}
+.modal .actions{gap:10px}.modal .actions>.button{min-height:48px}
+.modal>p{font-size:14px;line-height:1.5}
+.switch-row{gap:16px;min-height:56px}.switch-row>div{min-width:0;overflow-wrap:anywhere}
+.nav button{min-width:0}.nav .nav-icon{width:44px}
+@media(max-width:360px){
+ .home-fab{right:auto;margin-right:16px}
