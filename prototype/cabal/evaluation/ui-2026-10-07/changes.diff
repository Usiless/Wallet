+ .payment-row .grow{display:contents}
+ .payment-row strong{grid-column:1;grid-row:1}
+ .payment-row .money{grid-column:2;grid-row:1;align-self:start;font-size:14px}
+ .payment-row small{grid-column:1/-1;grid-row:2;margin-top:0}
+ .payment-row .chip{grid-column:1;grid-row:3;justify-self:start;margin:0}
+ .payment-row>.icon{grid-column:2;grid-row:3;justify-self:end}
+ .row .money{font-size:14px}.financial-summary strong{font-size:17px}
+ .split-row{grid-template-columns:minmax(0,1fr) 44px}
+ .split-row select{grid-column:1/-1}.split-row input{grid-column:1}.split-row button{grid-column:2;grid-row:2}
+}
