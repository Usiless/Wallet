+/* UI · tanda 1: lectura, acciones sin oclusión y errores accesibles. */
+:root{--muted:#4f6258}
+.row strong,.row .money,.account-card h4,.button,.text-button,
+.tabs button,.scroll-tabs button,.checkbox,.switch-row strong,.data-line{font-size:14px}
